# Optional X/Twitter API configuration
# Get a Bearer Token from https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# Optional Selenium login configuration
TWITTER_USERNAME=
TWITTER_PASSWORD=

# Selenium runtime mode
SELENIUM_HEADLESS=true
SELENIUM_MANUAL_LOGIN=false

# Application port
PORT=5001

# Flask session secret
SECRET_KEY=replace-with-a-random-string
